{
    "name": "@codingpheonix/gemini-live-wrapper",
    "version": "1.0.0",
    "description": "A TypeScript wrapper for Gemini Live with audio/video input and ephemeral token support.",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsc",
        "prepack": "npm run build"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/CodingPheonix/websocket-gemini-live-wrapper.git"
    },
    "keywords": [
        "gemini",
        "gemini-live",
        "google-genai",
        "websocket",
        "audio",
        "video",
        "typescript",
        "ai"
    ],
    "author": "CodingPheonix",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/CodingPheonix/websocket-gemini-live-wrapper/issues"
    },
    "homepage": "https://github.com/CodingPheonix/websocket-gemini-live-wrapper#readme",
    "dependencies": {
        "@google/genai": "^2.27.0"
    }
}
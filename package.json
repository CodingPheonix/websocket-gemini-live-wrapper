  "devDependencies": {
    "@types/node": "^26.6.4",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@google/genai": "^2.27.0"
